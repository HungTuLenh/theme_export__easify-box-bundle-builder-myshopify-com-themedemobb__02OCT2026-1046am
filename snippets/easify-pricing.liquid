<div style="display: grid; gap: 6px;">
<span style="font-size: 18px; font-weight: 600; color: rgb(143, 69, 0);"><span>Scale</span></span>
<span style="display: flex; align-items: baseline; gap: 6px;"><span style="font-size: 36px; font-weight: 600; line-height: 1; color: rgb(0, 0, 0);"><span>$99</span></span><span style="font-size: 16px; font-weight: 400; color: rgb(114, 114, 114);">/mo</span></span>
<span style="font-size: 16px; font-weight: 400; color: rgb(97, 97, 97);"><span>$5,001–$25,000/mo box revenue</span></span>
</div>
<div style="display: grid; gap: 9px; border-top: 1px solid rgb(227, 227, 227); border-bottom: 1px solid rgb(227, 227, 227); padding: 14px 0px;">
<span style="display: flex; justify-content: space-between; gap: 12px; font-size: 16px;"><span style="color: rgb(114, 114, 114);">Fee % of revenue</span><span style="font-weight: 600; color: rgb(48, 48, 48);"><span>&lt;2% at max</span></span></span>
<span style="display: flex; justify-content: space-between; gap: 12px; font-size: 16px;"><span style="color: rgb(114, 114, 114);">Net revenue kept</span><span style="font-weight: 600; color: rgb(48, 48, 48);"><span>&gt;98%</span></span></span>
<span style="display: flex; justify-content: space-between; gap: 12px; font-size: 16px;"><span style="color: rgb(114, 114, 114);">ROI on app spend</span><span style="font-weight: 600; color: rgb(48, 48, 48);"><span>49×–251×</span></span></span>
</div>
{% render 'easify-button', label: pricing_cta_label, href: pricing_app_store_link, variant: 'default', rel: 'noreferrer', target: '_blank' %}
<div style="display: grid; gap: 8px;">
</div>
</div>
<div class="ez-pricing-plan-card" style="background: rgb(255, 252, 248); border: 1px solid rgb(241, 227, 208); border-radius: 20px; padding: 26px; display: grid; gap: 18px; align-content: start; min-width: 0px;">
<div style="display: grid; gap: 6px;">
<span style="font-size: 18px; font-weight: 600; color: rgb(143, 69, 0);"><span>Thrive</span></span>
<span style="display: flex; align-items: baseline; gap: 6px;"><span style="font-size: 36px; font-weight: 600; line-height: 1; color: rgb(0, 0, 0);"><span>$199</span></span><span style="font-size: 16px; font-weight: 400; color: rgb(114, 114, 114);">/mo</span></span>
<span style="font-size: 16px; font-weight: 400; color: rgb(97, 97, 97);"><span>Unlimited box revenue</span></span>
</div>
<div style="display: grid; gap: 9px; border-top: 1px solid rgb(227, 227, 227); border-bottom: 1px solid rgb(227, 227, 227); padding: 14px 0px;">
<span style="display: flex; justify-content: space-between; gap: 12px; font-size: 16px;"><span style="color: rgb(114, 114, 114);">Fee % of revenue</span><span style="font-weight: 600; color: rgb(48, 48, 48);"><span>&lt;0.8% at $25k</span></span></span>
<span style="display: flex; justify-content: space-between; gap: 12px; font-size: 16px;"><span style="color: rgb(114, 114, 114);">Net revenue kept</span><span style="font-weight: 600; color: rgb(48, 48, 48);"><span>&gt;99.2%</span></span></span>
