{% liquid
  assign app_review_rating = settings.easify_app_review_rating
  assign testimonial_reviews_link = settings.easify_app_reviews_url
  assign testimonial_reviews_joiner = '?'
  if testimonial_reviews_link contains '?'
    assign testimonial_reviews_joiner = '&'
  endif
  assign testimonial_all_reviews_link = testimonial_reviews_link | append: testimonial_reviews_joiner | append: 'utm_source=demo-store&utm_medium=all-reviews'
  assign testimonial_stars = '★★★★★'
  assign testimonial_card_style = 'background: rgb(255, 252, 248); border: 1px solid rgb(241, 227, 208); border-radius: 20px; padding: 26px; display: grid; gap: 14px; grid-template-rows: auto auto 1fr; align-content: start; min-width: 0px; height: 100%; box-sizing: border-box;'
  assign testimonial_header_style = 'display: flex; justify-content: space-between; align-items: flex-start; gap: 10px;'
  assign testimonial_merchant_stack_style = 'display: grid; gap: 3px; min-width: 0px;'
  assign testimonial_store_style = 'font-size: 20px; font-weight: 600; line-height: 1.3; color: rgb(0, 0, 0);'
  assign testimonial_country_style = 'font-size: 13px; font-weight: 400; color: rgb(122, 106, 87);'
  assign testimonial_badge_style = 'flex: 0 0 auto; white-space: nowrap; border-radius: 20px; padding: 4px 10px; font-size: 11px; font-weight: 500;'
  assign testimonial_stars_style = 'color: rgb(239, 112, 27); font-size: 13px; letter-spacing: 2px;'
  assign testimonial_quote_style = 'margin: 0px; font-size: 15px; line-height: 1.6; color: rgb(74, 63, 51); text-wrap: pretty;'
%}
{% capture testimonial_filters -%}
all||All~~
gift||Gift & Lifestyle~~
fashion||Fashion & Apparel~~
food||Food & Drink~~
home||Home & Decor~~
jewelry||Jewelry~~
beauty||Beauty & Craft~~
sports||Sports & Fitness
