<div class="ez-testimonials-page" data-testimonials style="width: 100%; overflow-x: clip; background-color: rgb(255, 243, 232); background-image: linear-gradient(rgba(255, 134, 23, 0.16) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 134, 23, 0.16) 1px, transparent 1px); background-size: 56px 56px;">
<section class="ez-testimonials-hero" style="width: 100%; margin: 0px; padding: 72px 0px 0px; display: grid; gap: 20px; justify-items: start;">
<h1 style="margin: 0px; font-size: clamp(34px, 5.4vw, 72px); font-weight: 600; letter-spacing: -0.02em; line-height: 1.04; color: rgb(0, 0, 0); max-width: 20ch;">See what stores like yours are saying.</h1>
<div style="display: flex; flex-wrap: wrap; gap: 12px; align-items: center; font-size: 16px; color: rgb(122, 106, 87);">
<span style="color: rgb(239, 112, 27); letter-spacing: 2px;">{{ testimonial_stars }}</span>
<strong style="color: rgb(0, 0, 0); font-weight: 600;">{{ app_review_rating | escape }} average</strong>
<span style="color: rgb(224, 205, 182);">·</span><span>Free plan available</span>
<span style="color: rgb(224, 205, 182);">·</span><span>Built for Shopify</span>
</div>
<div aria-label="Filter testimonials by industry" data-testimonial-filters role="group" style="display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px;">
{% assign testimonial_filter_items = testimonial_filters | strip | split: '~~' %}
{% for testimonial_filter in testimonial_filter_items %}
  {% assign testimonial_filter_fields = testimonial_filter | strip | split: '||' %}
  {% assign testimonial_filter_value = testimonial_filter_fields[0] | strip %}
  {% assign testimonial_filter_label = testimonial_filter_fields[1] | strip %}
  <button aria-pressed="{% if testimonial_filter_value == 'all' %}true{% else %}false{% endif %}" data-testimonial-filter="{{ testimonial_filter_value | escape }}" type="button"><span>{{ testimonial_filter_label | escape }}</span></button>
{% endfor %}
</div>
</section>
<section aria-live="polite" class="ez-testimonials-grid" data-testimonial-grid style="width: 100%; margin: 0px; padding: 36px 0px 0px; display: grid; grid-template-columns: repeat(3, minmax(0px, 1fr)); gap: 20px; align-items: stretch;">
{% assign testimonial_items = testimonial_rows | strip | split: '~~' %}
{% for testimonial_item in testimonial_items %}
  {% assign testimonial_fields = testimonial_item | strip | split: '||' %}
  {% assign testimonial_category = testimonial_fields[0] | strip %}
  {% assign testimonial_featured = testimonial_fields[1] | strip %}
  {% assign testimonial_store = testimonial_fields[2] | strip %}
  {% assign testimonial_country = testimonial_fields[3] | strip %}
  {% assign testimonial_badge = testimonial_fields[4] | strip %}
  {% assign testimonial_badge_bg = testimonial_fields[5] | strip %}
  {% assign testimonial_badge_color = testimonial_fields[6] | strip %}
  {% assign testimonial_quote = testimonial_fields[7] | strip %}
  <div data-review-category="{{ testimonial_category | escape }}"{% if testimonial_featured == 'true' %} data-review-featured{% else %} hidden{% endif %} style="{{ testimonial_card_style }}">
    <div style="{{ testimonial_header_style }}">
      <div style="{{ testimonial_merchant_stack_style }}">
        <span style="{{ testimonial_store_style }}">{{ testimonial_store | escape }}</span>
        <span style="{{ testimonial_country_style }}">{{ testimonial_country | escape }}</span>
      </div>
      <span style="{{ testimonial_badge_style }} background: {{ testimonial_badge_bg }}; color: {{ testimonial_badge_color }};">{{ testimonial_badge | escape }}</span>
    </div>
    <span style="{{ testimonial_stars_style }}">{{ testimonial_stars }}</span>
    <p style="{{ testimonial_quote_style }}">{{ testimonial_quote | escape }}</p>
  </div>
{% endfor %}
</section>
<div style="width: min(1296px, 94vw); margin: 0px auto; padding: 40px 0px 96px; display: flex; justify-content: center;">
{% render 'easify-button', label: 'View all reviews', href: testimonial_all_reviews_link, variant: 'primary', rel: 'noreferrer', target: '_blank' %}
</div>
</div>
