  endcase

  assign image_url_prefix = image_source | slice: 0, 2
  if image_source contains '://'
    assign resolved_image_source = image_source
  elsif image_url_prefix == '//'
    assign resolved_image_source = image_source
  elsif image_source != blank
    assign resolved_image_source = image_source | asset_url
  else
    assign resolved_image_source = ''
  endif

  assign requested_width = width | default: 0 | plus: 0
  if requested_width > 0 and resolved_image_source contains 'cdn.shopify.com'
    assign image_transform_joiner = '?'
    if resolved_image_source contains '?'
      assign image_transform_joiner = '&'
    endif
    assign resolved_image_source = resolved_image_source | append: image_transform_joiner | append: 'width=' | append: requested_width
  endif
-%}

