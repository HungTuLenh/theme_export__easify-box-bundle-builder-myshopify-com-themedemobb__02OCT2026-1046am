{% capture home_mascot_source %}{% render 'easify-image-url', image: 'homeBbImage32' %}{% endcapture %}
{% capture default_mascot_source %}{% render 'easify-image-url', image: 'mascotCta' %}{% endcapture %}
{% liquid
  assign home_mascot_source = home_mascot_source | strip
  assign default_mascot_source = default_mascot_source | strip
  assign app_review_rating = settings.easify_app_review_rating
  assign app_store_rating_label = settings.easify_app_store_rating_label
  assign cta_free_plan_copy = 'Free until your boxes earn $500 a month.'
  assign cta_no_card_copy = 'No credit card required.'
  assign cta_free_plan_no_card_copy = cta_free_plan_copy | append: ' ' | append: cta_no_card_copy
  assign app_store_rating_summary = app_review_rating | append: '★ ' | append: app_store_rating_label
  assign app_store_cta_subtext = app_store_rating_summary | append: '. ' | append: cta_free_plan_copy
  assign cta_home_eyebrow = 'Stop searching!'
  assign cta_home_heading = "We built Easify because other apps weren't good enough."
  assign cta_home_subtext = 'Choose us. Let us help you win.'
  assign cta_install_label = 'Install now'
  assign cta_standard_heading = 'Ready to build your first box?'
  assign cta_standard_button_label = 'Start building free'
  assign cta_testimonials_heading = 'Your store could be next.'
  assign cta_variant = section.settings.variant | default: 'auto'
  if cta_variant == 'auto'
    assign request_path = request.path | default: ''
    if request_path contains '/pages/testimonials'
      assign cta_variant = 'testimonials'
    elsif request_path contains '/pages/pricing'
      assign cta_variant = 'pricing'
    elsif request_path contains '/pages/demo'
      assign cta_variant = 'demo'
    else
      assign cta_variant = 'home'
    endif
  endif

  case cta_variant
    when 'home'
      assign default_eyebrow = cta_home_eyebrow
      assign default_heading = cta_home_heading
      assign default_subtext = cta_home_subtext
      assign default_button_label = cta_install_label
      assign default_note = ''
    when 'testimonials'
      assign default_eyebrow = ''
      assign default_heading = cta_testimonials_heading
      assign default_subtext = cta_free_plan_no_card_copy
      assign default_button_label = cta_install_label
      assign default_note = ''
    else
      assign default_eyebrow = ''
      assign default_heading = cta_standard_heading
      assign default_subtext = app_store_cta_subtext
      assign default_button_label = cta_standard_button_label
      assign default_note = cta_no_card_copy
  endcase

  assign cta_eyebrow = default_eyebrow
  assign cta_heading = default_heading
  assign cta_subtext = default_subtext
  assign cta_button_label = default_button_label
  assign cta_note = default_note
  if section.settings.eyebrow != blank
    assign cta_eyebrow = section.settings.eyebrow
  endif
  if section.settings.heading != blank
    assign cta_heading = section.settings.heading
  endif
  assign cta_subtext_setting = section.settings.subtext | strip
  if cta_subtext_setting != blank
    assign cta_subtext = section.settings.subtext
  endif
  if section.settings.button_label != blank
    assign cta_button_label = section.settings.button_label
  endif
  if section.settings.note != blank
    assign cta_note = section.settings.note
  endif

  assign app_store_link = settings.easify_app_store_url
  assign footer_app_store_joiner = '?'
  if app_store_link contains '?'
    assign footer_app_store_joiner = '&'
  endif
  assign footer_app_store_link = app_store_link | append: footer_app_store_joiner | append: 'utm_source=demo-store&utm_medium=footer'
  assign cta_link = section.settings.button_link
  if cta_link == blank or cta_link == app_store_link
    assign cta_link = footer_app_store_link
  endif

  assign mascot_layout = section.settings.mascot_layout | default: 'auto'
  if mascot_layout == 'auto'
    assign mascot_layout = 'home'
  endif

  assign cta_art_height = section.settings.art_height

  assign has_custom_mascot = false
  if section.settings.mascot_image != blank
    assign has_custom_mascot = true
    assign mascot_source = section.settings.mascot_image | image_url: width: 1400
  elsif mascot_layout == 'home'
    assign mascot_source = home_mascot_source
  else
    assign mascot_source = default_mascot_source
  endif
%}

<div
  class="easify-mascot-cta-root"
  data-animate-mascot="{{ section.settings.animate_mascot }}"
  data-cta-custom-mascot="{{ has_custom_mascot }}"
  data-cta-variant-setting="{{ section.settings.variant }}"
  data-easify-final
  data-mascot-cta-root
  data-page-variant="{{ cta_variant }}"
>
  <section
    aria-labelledby="MascotCtaHeading-{{ section.id }}"
    class="ez-mascot-cta ez-mascot-cta--{{ mascot_layout }}"
    data-mascot-cta
    style="--ez-cta-art-height: {{ cta_art_height }}px;"
  >
    <div class="ez-mascot-cta__content">
      <span class="ez-mascot-cta__eyebrow" data-mascot-cta-eyebrow {% if cta_eyebrow == blank %}hidden{% endif %}>{{ cta_eyebrow | escape }}</span>
      <h2 class="ez-mascot-cta__heading" data-mascot-cta-heading id="MascotCtaHeading-{{ section.id }}">{{ cta_heading | escape | newline_to_br }}</h2>
      <p class="ez-mascot-cta__subtext" data-mascot-cta-subtext {% if cta_subtext == blank %}hidden{% endif %}>{{ cta_subtext | escape | newline_to_br }}</p>
      <a
        class="ez-mascot-cta__button"
        data-mascot-cta-button
        href="{{ cta_link | escape }}"
        {% if section.settings.open_new_tab %}rel="noreferrer" target="_blank"{% endif %}
      >{{ cta_button_label | escape }}</a>
      <span class="ez-mascot-cta__note" data-mascot-cta-note {% unless section.settings.show_note and cta_note != blank %}hidden{% endunless %}>{{ cta_note | escape }}</span>
    </div>

    <div class="ez-mascot-cta__art">
      <div class="ez-mascot-cta__cloud ez-mascot-cta__cloud--left"></div>
      <div class="ez-mascot-cta__cloud ez-mascot-cta__cloud--right"></div>
      <div class="ez-mascot-cta__mascot">
        <div class="ez-mascot-cta__shadow"></div>
        <img alt="Easify mascot" data-mascot-cta-image decoding="async" height="1080" loading="lazy" src="{{ mascot_source }}" width="1080"/>
      </div>
    </div>
  </section>
  <script data-mascot-cta-defaults type="application/json">
    {
      "home": {
        "eyebrow": {{ cta_home_eyebrow | json }},
        "heading": {{ cta_home_heading | json }},
        "subtext": {{ cta_home_subtext | json }},
        "buttonLabel": {{ cta_install_label | json }},
        "note": "",
        "layout": "home",
        "asset": {{ home_mascot_source | json }}
      },
      "demo": {
        "eyebrow": "",
        "heading": {{ cta_standard_heading | json }},
        "subtext": {{ app_store_cta_subtext | json }},
        "buttonLabel": {{ cta_standard_button_label | json }},
        "note": {{ cta_no_card_copy | json }},
        "layout": "home",
        "asset": {{ home_mascot_source | json }}
      },
      "pricing": {
        "eyebrow": "",
        "heading": {{ cta_standard_heading | json }},
        "subtext": {{ app_store_cta_subtext | json }},
        "buttonLabel": {{ cta_standard_button_label | json }},
        "note": {{ cta_no_card_copy | json }},
        "layout": "home",
        "asset": {{ home_mascot_source | json }}
      },
      "testimonials": {
        "eyebrow": "",
        "heading": {{ cta_testimonials_heading | json }},
        "subtext": {{ cta_free_plan_no_card_copy | json }},
        "buttonLabel": {{ cta_install_label | json }},
        "note": "",
        "layout": "home",
        "asset": {{ home_mascot_source | json }}
      }
    }
  </script>
</div>

{% stylesheet %}
  .easify-mascot-cta-root {
    overflow:hidden;
    background:#fff3e8;
    color:#000;
    font-family:"Inter Tight",-apple-system,"Segoe UI",sans-serif;
  }
  .easify-mascot-cta-root,
  .easify-mascot-cta-root * {
    box-sizing:border-box;
  }
  .easify-mascot-cta-root[data-cta-variant-setting="auto"]:not([data-mascot-cta-ready="true"]) {
    visibility:hidden;
  }
  .easify-mascot-cta-root .ez-mascot-cta {
    position:relative;
    width:100%;
    overflow:hidden;
    box-sizing:border-box;
    padding:72px 0 0;
    text-align:center;
    background-color:#fff3e8;
    background-image:linear-gradient(rgba(255,134,23,.16) 1px,transparent 1px),linear-gradient(90deg,rgba(255,134,23,.16) 1px,transparent 1px);
    background-size:56px 56px;
  }
  .easify-mascot-cta-root .ez-mascot-cta__content {
    position:relative;
    z-index:2;
    width:min(1203px,100%);
    margin:0 auto;
    display:grid;
    gap:16px;
    justify-items:center;
    padding:0 24px;
  }
  .easify-mascot-cta-root .ez-mascot-cta__eyebrow,
  .easify-mascot-cta-root .ez-mascot-cta__subtext,
  .easify-mascot-cta-root .ez-mascot-cta__note {
    margin:0;
    color:#8f4500;
    font-weight:500;
  }
  .easify-mascot-cta-root .ez-mascot-cta__eyebrow {
    font-size:24px;
    line-height:1.2;
  }
  .easify-mascot-cta-root .ez-mascot-cta__heading {
    margin:0;
    max-width:24ch;
    color:#8f4500;
    font-size:clamp(34px,4.6vw,62px);
    font-weight:700;
    letter-spacing:-.02em;
    line-height:1.08;
  }
  .easify-mascot-cta-root .ez-mascot-cta__subtext {
    max-width:60ch;
    font-size:24px;
    line-height:1.2;
  }
  .easify-mascot-cta-root .ez-mascot-cta__note {
    margin-top:6px;
    font-size:16px;
    font-weight:600;
  }
  .easify-mascot-cta-root .ez-mascot-cta__button {
    margin-top:18px;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    box-sizing:border-box;
    position:relative;
    overflow:visible;
    padding:clamp(18px,2.6vw,40px) clamp(38px,5.6vw,80px);
    border-radius:99999px;
    border:5px solid #000;
    background:#fff;
    color:#2e2b00;
    box-shadow:7px 8px 0 #000;
    font-size:clamp(26px,4.2vw,60px);
    font-weight:500;
    line-height:1.2;
    white-space:nowrap;
    text-decoration:none;
    transform:rotate(2deg);
    transition:transform 160ms ease-out,box-shadow 160ms ease-out;
  }
  .easify-mascot-cta-root .ez-mascot-cta__button:hover {
    color:#2e2b00;
    transform:rotate(2deg) translate(-2px,-2px);
    box-shadow:10px 11px 0 #000;
  }
  .easify-mascot-cta-root .ez-mascot-cta__button:focus-visible {
    outline:4px solid #ef701b;
    outline-offset:5px;
  }
  html.ez-motion-ready .easify-mascot-cta-root .ez-mascot-cta__button[data-ez-motion] {
    overflow:visible;
    clip-path:none !important;
  }
  .easify-mascot-cta-root .ez-mascot-cta__art {
    position:relative;
    width:100%;
    max-width:100%;
    height:var(--ez-cta-art-height,500px);
    min-height:0;
    margin-top:-10px;
  }
  .easify-mascot-cta-root .ez-mascot-cta__cloud {
    position:absolute;
    top:18%;
    width:83.4%;
    height:120%;
    background:#fff;
    border-radius:50% 50% 0 0/44% 44% 0 0;
    pointer-events:none;
  }
  .easify-mascot-cta-root .ez-mascot-cta__cloud--left { left:-28%; }
  .easify-mascot-cta-root .ez-mascot-cta__cloud--right { right:-28%; }
  .easify-mascot-cta-root .ez-mascot-cta__mascot {
    position:relative;
    overflow:hidden;
    --ez-mascot-x:0;
    width:min(880px,96vw);
    aspect-ratio:1;
    margin:18px auto 0;
    transform:translateX(var(--ez-mascot-x));
    animation:ezMascotCtaBob 3.4s ease-in-out infinite;
  }
  .easify-mascot-cta-root .ez-mascot-cta__mascot img {
    position:absolute;
    inset:0;
    display:block;
    width:100%;
    height:100%;
    object-fit:contain;
    pointer-events:none;
  }
  .easify-mascot-cta-root .ez-mascot-cta__shadow {
    position:absolute;
    left:24.8%;
    top:84.7%;
    width:49.6%;
    height:8.07%;
    border-radius:50%;
    background:#512500;
    opacity:.12;
    animation:ezMascotCtaShadow 3.4s ease-in-out infinite;
  }
  .easify-mascot-cta-root .ez-mascot-cta--home { padding-top:60px; }
  .easify-mascot-cta-root .ez-mascot-cta--home .ez-mascot-cta__content { gap:16px; }
  .easify-mascot-cta-root .ez-mascot-cta--home .ez-mascot-cta__heading {
    max-width:22ch;
    font-size:clamp(52px,5.55vw,80px);
    font-weight:600;
    line-height:1.2;
  }
  .easify-mascot-cta-root .ez-mascot-cta--home .ez-mascot-cta__art { margin-top:-28px; }
  .easify-mascot-cta-root[data-animate-mascot="false"] .ez-mascot-cta__mascot,
  .easify-mascot-cta-root[data-animate-mascot="false"] .ez-mascot-cta__shadow {
    animation:none;
  }

  @media (min-width:768px) {
    .easify-mascot-cta-root .ez-mascot-cta--home .ez-mascot-cta__mascot {
      top:-126px;
    }
  }

  @keyframes ezMascotCtaBob {
    0%,100% { transform:translateX(var(--ez-mascot-x)) translateY(0); }
    50% { transform:translateX(var(--ez-mascot-x)) translateY(-8px); }
  }
  @keyframes ezMascotCtaShadow {
    0%,100% { transform:scaleX(1); opacity:.12; }
    50% { transform:scaleX(.92); opacity:.08; }
  }

  @media (max-width:767px) {
    .easify-mascot-cta-root .ez-mascot-cta { padding:56px 0 0; }
    .easify-mascot-cta-root .ez-mascot-cta__content {
      width:100%;
      padding:0 16px;
    }
    .easify-mascot-cta-root .ez-mascot-cta__eyebrow { font-size:18px; }
    .easify-mascot-cta-root .ez-mascot-cta__heading,
    .easify-mascot-cta-root .ez-mascot-cta--home .ez-mascot-cta__heading {
      font-size:40px;
      line-height:1.08;
    }
    .easify-mascot-cta-root .ez-mascot-cta__subtext {
      font-size:16px;
      line-height:1.4;
    }
    .easify-mascot-cta-root .ez-mascot-cta__button {
      max-width:100%;
      padding:18px 28px;
      font-size:clamp(28px,9vw,40px);
      white-space:normal;
    }
    .easify-mascot-cta-root .ez-mascot-cta__art {
      height:384px;
      min-height:384px;
      margin-top:10px;
    }
    .easify-mascot-cta-root .ez-mascot-cta__mascot {
      left:50%;
      --ez-mascot-x:-50%;
      width:min(640px,112vw);
      margin-left:0;
      margin-right:0;
    }
  }

  @media (prefers-reduced-motion:reduce) {
    .easify-mascot-cta-root *,
    .easify-mascot-cta-root *::before,
    .easify-mascot-cta-root *::after {
      animation:none !important;
      transition:none !important;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Mascot call to action",
  "tag": "section",
  "class": "easify-mascot-cta-section",
  "settings": [
    {
      "type": "select",
      "id": "variant",
      "label": "Page defaults",
      "default": "auto",
      "options": [
        { "value": "auto", "label": "Auto detect" },
        { "value": "home", "label": "Home" },
        { "value": "demo", "label": "Demo" },
        { "value": "pricing", "label": "Pricing" },
        { "value": "testimonials", "label": "Testimonials" }
      ]
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "textarea", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "subtext", "label": "Supporting text" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "checkbox", "id": "open_new_tab", "label": "Open button in a new tab", "default": true },
    { "type": "checkbox", "id": "show_note", "label": "Show note", "default": true },
    { "type": "text", "id": "note", "label": "Note" },
    {
      "type": "select",
      "id": "mascot_layout",
      "label": "Mascot layout",
      "default": "auto",
      "options": [
        { "value": "auto", "label": "Auto" },
        { "value": "home", "label": "Home large" },
        { "value": "full", "label": "Full mascot" }
      ]
    },
    { "type": "image_picker", "id": "mascot_image", "label": "Custom mascot image" },
    { "type": "checkbox", "id": "animate_mascot", "label": "Animate mascot", "default": true },
    {
      "type": "range",
      "id": "art_height",
      "label": "Mascot area height",
      "min": 320,
      "max": 560,
      "step": 10,
      "unit": "px",
      "default": 500
    }
  ],
  "presets": [{ "name": "Mascot call to action" }]
}
{% endschema %}
