<script>
(function(){
  var R=document.getElementById('easify-pp'); if(!R) return;
  var secs=function(){return R.querySelectorAll('[data-pp-sec]');};
  var links=function(){return R.querySelectorAll('[data-toc-link]');};
  var shell=R.querySelector('[data-toc-shell]'), lock=null, lockT;
  var nav=R.querySelector('[data-site-nav]'), tg=nav&&nav.querySelector('.bb-menu-toggle');
  if(nav&&tg){
    var setOpen=function(o){nav.setAttribute('data-menu-open',o?'true':'false');tg.setAttribute('aria-expanded',o?'true':'false');tg.setAttribute('aria-label',o?'Close menu':'Open menu');};
    tg.addEventListener('click',function(e){e.stopPropagation();setOpen(nav.getAttribute('data-menu-open')!=='true');});
    nav.querySelectorAll('.bb-nav-link').forEach(function(l){l.addEventListener('click',function(){setOpen(false);});});
    document.addEventListener('keydown',function(e){if(e.key==='Escape')setOpen(false);});
  }
  function paint(active){
    var label='';
    links().forEach(function(a){var on=a.getAttribute('data-toc-link')===active;a.setAttribute('data-on',on?'true':'false');if(on)label=a.textContent;});
    var cur=R.querySelector('[data-toc-current]'); if(cur&&label) cur.textContent=label;
  }
  function onScroll(){
    var bar=R.querySelector('[data-pp-progress]'), h=document.documentElement;
    if(bar){var max=h.scrollHeight-h.clientHeight;bar.style.width=(max>0?Math.min(100,h.scrollTop/max*100):0)+'%';}
    if(lock) return;
    var active=null;
    secs().forEach(function(s){if(s.getBoundingClientRect().top<=140) active=s.id;});
    if(!active){var f=secs()[0];active=f&&f.id;}
    paint(active);
  }
  document.addEventListener('click',function(e){
    var t=e.target.closest&&e.target.closest('[data-toc-toggle]');
    if(t&&shell){shell.setAttribute('data-open',shell.getAttribute('data-open')==='true'?'false':'true');return;}
    var a=e.target.closest&&e.target.closest('[data-toc-link]');
    if(shell) shell.setAttribute('data-open','false');
    if(!a) return;
    var id=a.getAttribute('data-toc-link'); lock=id; paint(id);
    clearTimeout(lockT); lockT=setTimeout(function(){lock=null;onScroll();},900);
  });
  window.addEventListener('scroll',onScroll,{passive:true});
  window.addEventListener('resize',onScroll);
  onScroll();
})();
</script>
