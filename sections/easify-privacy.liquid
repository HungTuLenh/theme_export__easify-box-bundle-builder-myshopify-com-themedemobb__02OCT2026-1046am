<style>
  html { scroll-behavior:smooth; }
  body:has(#easify-pp) .shopify-section:has([data-site-nav]):not(:has(#easify-pp)) { display:none !important; }
  body:has(#easify-pp) [data-site-nav]:not(#easify-pp [data-site-nav]) { display:none !important; }
  #easify-pp .bb-site-nav { position:absolute; top:40px; left:50%; z-index:20; width:min(1280px,calc(100% - 48px)); height:76px; transform:translateX(-50%); display:flex; align-items:center; gap:16px; color:#000; box-sizing:border-box; }
  #easify-pp .bb-site-nav * { box-sizing:border-box; }
  #easify-pp .bb-site-nav-main { position:relative; min-width:0; height:76px; flex:1 1 auto; border-radius:16px; background:#fff; display:flex; align-items:center; justify-content:space-between; padding:14px 32px; }
  #easify-pp .bb-brand { height:48px; display:flex; align-items:center; flex-shrink:0; }
  #easify-pp .bb-brand img { display:block; width:auto; max-width:100%; height:48px; margin:0; object-fit:contain; }
  #easify-pp .bb-menu-toggle { display:none; appearance:none; }
  #easify-pp .bb-nav-links { height:44px; display:flex; align-items:center; flex-shrink:0; gap:4px; }
  #easify-pp .bb-nav-link { height:44px; display:flex; align-items:center; justify-content:center; padding:0 12px; border-radius:999999px; color:#000; font:500 20px/1.2 "Inter Tight",sans-serif; white-space:nowrap; transition:background .25s,color .25s; }
  #easify-pp .bb-nav-link:hover { background:#f3eee9; color:#000; }
  #easify-pp .bb-nav-cta { height:76px; flex:none; border-radius:16px; background:#000; color:#fff; display:flex; align-items:center; gap:12px; padding:0 24px; font:500 20px/1.2 "Inter Tight",sans-serif; white-space:nowrap; transition:background .2s; }
  #easify-pp .bb-nav-cta:hover { background:#151515; color:#fff; }
  #easify-pp .bb-nav-cta-icon { width:32px; height:32px; flex:none; background-size:contain; background-repeat:no-repeat; background-position:center; }
  @media (max-width:1199px) {
    #easify-pp .bb-site-nav { top:24px; left:24px; right:24px; width:auto; height:68px; transform:none; gap:12px; }
    #easify-pp .bb-site-nav-main { height:68px; padding:12px 18px; }
    #easify-pp .bb-brand, #easify-pp .bb-brand img { height:40px; }
    #easify-pp .bb-nav-cta { height:68px; font-size:18px; padding:0 20px; }
    #easify-pp .bb-menu-toggle { position:relative; width:44px; height:44px; flex-shrink:0; display:flex; align-items:center; justify-content:center; padding:0; border:0; background:transparent; color:#000; -webkit-appearance:none; box-shadow:none; cursor:pointer; }
    #easify-pp .bb-menu-toggle span { position:absolute; width:28px; height:3px; border-radius:3px; background:currentColor; transition:opacity .2s,transform .2s; }
    #easify-pp .bb-menu-toggle span:first-child { transform:translateY(-8px); }
    #easify-pp .bb-menu-toggle span:last-child { transform:translateY(8px); }
    #easify-pp .bb-site-nav[data-menu-open="true"] .bb-menu-toggle span:first-child { transform:rotate(45deg); }
    #easify-pp .bb-site-nav[data-menu-open="true"] .bb-menu-toggle span:nth-child(2) { opacity:0; }
    #easify-pp .bb-site-nav[data-menu-open="true"] .bb-menu-toggle span:last-child { transform:rotate(-45deg); }
    #easify-pp .bb-nav-links { position:absolute; top:calc(100% + 10px); left:0; right:0; display:none; width:100%; height:auto; padding:12px; border-radius:16px; background:#fff; box-shadow:0 16px 40px #5f2d0029; flex-direction:column; align-items:stretch; gap:4px; }
    #easify-pp .bb-site-nav[data-menu-open="true"] .bb-nav-links { display:flex; }
    #easify-pp .bb-nav-link { min-height:52px; justify-content:flex-start; border-radius:10px; padding:0 18px; }
    #easify-pp .bb-nav-link:hover { background:#fff3e7; }
  }
  @media (max-width:767px) {
    #easify-pp .bb-site-nav { top:16px; left:16px; right:16px; height:60px; }
    #easify-pp .bb-site-nav-main { height:60px; padding:8px 12px; border-radius:14px; }
    #easify-pp .bb-brand, #easify-pp .bb-brand img { height:36px; }
    #easify-pp .bb-nav-cta { display:none; }
  }
  main:has(#easify-pp), #MainContent:has(#easify-pp), .content-for-layout:has(#easify-pp) { padding-top:0 !important; margin-top:0 !important; }
  body:has(#easify-pp) { background:#FFF3E7; }
  [id^="shopify-section-"]:has(#easify-pp) { margin:0 !important; padding:0 !important; }
  main:has(#easify-pp), #MainContent:has(#easify-pp) { padding-bottom:0 !important; margin-bottom:0 !important; }
  body:has(#easify-pp) .shopify-section-group-footer-group, body:has(#easify-pp) footer, body:has(#easify-pp) .footer { margin-top:0 !important; }
  #easify-pp > div:last-child { padding-bottom:0; }
  #easify-pp { background:#FFF3E7; font-family:'Inter Tight',system-ui,sans-serif; color:#1A1206; -webkit-font-smoothing:antialiased; line-height:normal; letter-spacing:normal; }
  #easify-pp h1, #easify-pp h2, #easify-pp h3, #easify-pp p, #easify-pp a, #easify-pp span, #easify-pp small, #easify-pp li, #easify-pp div, #easify-pp nav { font-family:inherit; }
  #easify-pp h1, #easify-pp h2, #easify-pp h3 { word-break:normal; }
  #easify-pp ul { margin:0; padding:0; }
  #easify-pp li::before, #easify-pp li::marker { content:none; }
  #easify-pp a { color:#1A1206; text-decoration:none; }
  #easify-pp a:hover { color:#B45A00; }
  #easify-pp ::selection { background:#1A1206; color:#fff; }
  #easify-pp [data-toc-link]:hover { background:#FFF3E7 !important; color:#B45A00 !important; }
  #easify-pp [data-toc-link][data-on="true"] { background:#1A1206 !important; color:#fff !important; }
  #easify-pp [data-pp-sec] { scroll-margin-top:110px; }
  #easify-pp [data-toc-toggle] { display:none; }
  @media (max-width: 1060px) {
    #easify-pp [data-toc-shell] { flex:1 1 100% !important; max-width:none !important; background:transparent !important; border:0 !important; padding:0 !important; top:10px !important; z-index:60; }
    #easify-pp [data-toc-eyebrow] { display:none !important; }
    #easify-pp [data-toc-toggle] { display:inline-flex !important; }
    #easify-pp [data-toc-list] { display:none !important; position:absolute; left:0; right:0; top:calc(100% + 10px); background:#fff; border:1px solid #1A1206; border-radius:16px; padding:10px; box-shadow:0 20px 44px rgba(26,18,6,.22); max-height:58vh; }
    #easify-pp [data-toc-shell][data-open="true"] [data-toc-list] { display:grid !important; }
    #easify-pp [data-toc-chevron] { transition:transform 160ms cubic-bezier(.4,.22,.28,1); }
    #easify-pp [data-toc-shell][data-open="true"] [data-toc-chevron] { transform:rotate(180deg); }
    #easify-pp [data-hero-wrap] { margin-top:44px !important; }
    #easify-pp > div > div:nth-child(2) { padding-top:60px !important; }
    #easify-pp [data-hero-intro] { height:auto !important; font-size:17px !important; line-height:1.6 !important; }
  }
  #easify-pp [data-h="1"]:hover{transform:translateY(-4px) !important;box-shadow:0 16px 34px rgba(26,18,6,.13) !important;border-color:#1A1206 !important;color:#1A1206 !important}
  #easify-pp [data-h="2"]:hover{background:#FFF3E7 !important;color:#1A1206 !important}
  @media (prefers-reduced-motion: reduce) { #easify-pp * { animation:none !important; transition:none !important; } }
</style>
<div id="easify-pp">
<div style="width:100%;overflow-x:clip;background:#FFF3E7">
  <div data-pp-progress="" style="position:fixed;left:0;top:0;height:4px;width:0%;background:#FF8617;z-index:120;transition:width 90ms linear"></div>
  <div style="position:relative;background:#FF7300;padding:100px 0 96px">
    <div style="position:absolute;inset:0;background-image:linear-gradient(#FF8725 .5px,transparent .5px),linear-gradient(90deg,#FF8725 .5px,transparent .5px);background-size:57px 57px;pointer-events:none"></div>
{% liquid
  assign pp_app_link = settings.easify_app_store_url | default: 'https://apps.shopify.com/easify-box-builder'
