{% schema %}
{
  "name": "Easify mascot game",
  "tag": "section",
  "class": "easify-home-game-section",
  "settings": [
    {
      "type": "select",
      "id": "visibility",
      "label": "Visibility",
      "default": "always",
      "options": [
        { "value": "always", "label": "Always" },
        { "value": "auto", "label": "Auto detect Home" }
      ]
    },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Come play with us" },
    { "type": "text", "id": "subtext", "label": "Supporting text", "default": "60,000+ Shopify merchants can't be wrong" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Try Easify apps" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Easify mascot game" }]
}
{% endschema %}
