}
.easify-home-game-root .easify-mini-game .option > img {
  display:block;
  width:100%;
  height:100%;
  min-width:0;
  min-height:0;
  object-fit:contain;
  pointer-events:none;
}
.easify-home-game-root .easify-mini-game .group-eyes .option > img {
